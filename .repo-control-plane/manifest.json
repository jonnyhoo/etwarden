{
	"skill": "repo-control-plane",
	"manifestVersion": 1,
	"repoName": "etwarden",
	"repoKind": "rust-windows-cli",
	"canonicalDocs": {
		"llmEntry": "AGENTS.md",
		"architecture": "ARCHITECTURE.md",
		"glossary": "CONTEXT.md",
		"devStandards": "docs/DEV_STANDARDS.md",
		"roadmap": "docs/ROADMAP.md",
		"taskPlan": "docs/TASK_PLAN.md",
		"handoffWinDivert": "docs/HANDOFF_WINDIVERT.md"
	},
	"planes": {
		"product": {
			"roots": ["src/", "tests/", "benches/"],
			"config": [
				"Cargo.toml",
				"Cargo.lock",
				"rustfmt.toml",
				"deny.toml",
				".coupling.toml"
			],
			"invariant": "Product code never depends on control-plane scripts."
		},
		"control": {
			"roots": [".repo-control-plane/", "scripts/", ".githooks/"],
			"invariant": "Control plane never mutates product runtime behavior."
		}
	},
	"hookLanes": {
		"globalPreCommit": {
			"owner": "global-fortress",
			"runs": ["generic-text-guards", "cargo fmt (auto-fix)", "language-lanes"],
			"doc": "Owned by global fortress hooks. Repo pre-commit must not duplicate Rust formatting."
		},
		"globalPrePush": {
			"owner": "global-fortress",
			"runs": [
				"generic-text-guards",
				"language-lanes",
				"Rust fmt/clippy fallback only when repo pre-push is absent"
			],
			"doc": "Global pre-push skips Rust fallback when .githooks/pre-push exists."
		},
		"repoPreCommit": {
			"owner": "repo",
			"runs": [
				"check-control-plane",
				"check-docs",
				"cargo check -p etwarden",
				"git diff --check"
			],
			"doc": "Fast repo gate only. No fmt/clippy/tests."
		},
		"repoPrePush": {
			"owner": "repo",
			"runs": [
				"cargo +nightly fmt --all --check",
				"cargo check -p etwarden",
				"cargo clippy --all-targets --all-features -- -D warnings",
				"cargo audit --no-fetch --stale",
				"cargo deny check --disable-fetch",
				"cargo machete",
				"cargo +nightly udeps --all-targets --all-features",
				"cargo hack check --all-targets --feature-powerset",
				"cargo semver-checks --baseline-rev <latest-tag>",
				"cargo coupling --check --no-git --max-circular 5",
				"cargo nextest run",
				"cargo test --doc",
				"cargo doc --no-deps",
				"git diff --check"
			],
			"doc": "Complete Rust/static push gate. Owns fmt/clippy because global pre-push delegates Rust checks when repo hook exists."
		},
		"adminRelease": {
			"owner": "repo",
			"runs": [
				"cargo nextest run --features integration",
				"cargo llvm-cov --summary-only",
				"cargo bench --no-run"
			],
			"doc": "Requires admin runner. Not in pre-commit/pre-push."
		}
	},
	"testRunner": {
		"primary": "cargo-nextest",
		"fallback": "cargo test",
		"doctest": "cargo test --doc",
		"doc": "Use cargo nextest run as canonical test runner. Fallback only when nextest is absent."
	},
	"commands": {
		"entry": "pwsh -NoProfile -File scripts/repo-control.ps1 entry",
		"status": "pwsh -NoProfile -File scripts/repo-control.ps1 status",
		"doctor": "pwsh -NoProfile -File scripts/repo-control.ps1 doctor",
		"checkControlPlane": "pwsh -NoProfile -File scripts/repo-control.ps1 check-control-plane",
		"checkDocs": "pwsh -NoProfile -File scripts/repo-control.ps1 check-docs",
		"gatePreCommit": "pwsh -NoProfile -File scripts/repo-control.ps1 gate:pre-commit",
		"gatePrePush": "pwsh -NoProfile -File scripts/repo-control.ps1 gate:pre-push",
		"verifyFocused": "pwsh -NoProfile -File scripts/repo-control.ps1 verify:focused",
		"verifyFull": "pwsh -NoProfile -File scripts/repo-control.ps1 verify:full",
		"verifyAdmin": "pwsh -NoProfile -File scripts/repo-control.ps1 verify:admin",
		"packageRelease": "pwsh -NoProfile -File scripts/repo-control.ps1 package:release -WinDivertRoot <official-release-or-build-root>",
		"hooksInstall": "pwsh -NoProfile -File scripts/repo-control.ps1 hooks:install",
		"hooksDoctor": "pwsh -NoProfile -File scripts/repo-control.ps1 hooks:doctor"
	},
	"requiredTools": [
		"git",
		"cargo",
		"cargo-nextest",
		"cargo-deny",
		"cargo-audit",
		"cargo-machete",
		"cargo-coupling",
		"cargo-udeps",
		"cargo-hack",
		"cargo-semver-checks",
		"cargo-clippy",
		"rustup"
	],
	"optionalTools": ["cargo-llvm-cov", "cargo-criterion"],
	"managedFiles": [
		".repo-control-plane/manifest.json",
		".repo-control-plane/hook-lanes.json",
		".repo-control-plane/static-gates/artifact-policy.json",
		".repo-control-plane/cache/.gitkeep",
		".repo-control-plane/runtime/.gitkeep",
		"scripts/repo-control.ps1",
		".githooks/pre-commit",
		".githooks/pre-push",
		"scripts/package-release.ps1",
		".gitattributes",
		".gitignore",
		"AGENTS.md",
		"CLAUDE.md",
		"docs/DEV_STANDARDS.md"
	]
}
