{
	"schemaVersion": 1,
	"lanes": [
		{
			"id": "global-pre-commit",
			"layer": "global",
			"phases": ["pre-commit"],
			"owner": "global-fortress",
			"runs": ["generic-text-guards", "cargo fmt (auto-fix)", "language-lanes"],
			"dedupRule": "Repo pre-commit must not duplicate Rust formatting."
		},
		{
			"id": "global-pre-push",
			"layer": "global",
			"phases": ["pre-push"],
			"owner": "global-fortress",
			"runs": [
				"generic-text-guards",
				"language-lanes",
				"Rust fmt/clippy fallback only when repo pre-push is absent"
			],
			"dedupRule": "When .githooks/pre-push exists, repo pre-push owns Rust push gates."
		},
		{
			"id": "repo-pre-commit",
			"layer": "repo",
			"phases": ["pre-commit"],
			"owner": "repo",
			"runs": [
				"check-control-plane",
				"check-docs",
				"cargo check -p etwarden",
				"git diff --check"
			],
			"dedupRule": "Fast only. No fmt, no clippy, no tests."
		},
		{
			"id": "repo-pre-push",
			"layer": "repo",
			"phases": ["pre-push"],
			"owner": "repo",
			"runs": [
				"cargo +nightly fmt --all --check",
				"cargo check -p etwarden",
				"cargo clippy --all-targets --all-features -- -D warnings",
				"cargo audit --no-fetch --stale",
				"cargo deny check --disable-fetch",
				"cargo machete",
				"cargo +nightly udeps --all-targets --all-features",
				"cargo hack check --all-targets --feature-powerset",
				"cargo semver-checks --baseline-rev <latest-tag>",
				"cargo coupling --check --no-git --max-circular 5",
				"cargo nextest run",
				"cargo test --doc",
				"cargo doc --no-deps",
				"git diff --check"
			],
			"dedupRule": "Repo pre-push owns the complete Rust/static push gate because global pre-push skips Rust fallback when this hook exists."
		},
		{
			"id": "admin-release",
			"layer": "manual",
			"phases": ["manual"],
			"owner": "repo",
			"runs": [
				"cargo nextest run --features integration",
				"cargo llvm-cov --summary-only",
				"cargo bench --no-run"
			],
			"dedupRule": "Requires admin runner. Never in pre-commit or pre-push."
		}
	]
}
