/target
/captures
/logs/coupling*.json
/dist

# Local runtime artifacts at repo root
/*.log
/spawn_test*.txt
/etwarden-mitm-ca.crt
/etwarden-mitm-ca.key

# WinDivert runtime artifacts are packaged into /dist by scripts/package-release.ps1.
