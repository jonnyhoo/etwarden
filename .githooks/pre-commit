#!/usr/bin/env bash
# etwarden repo pre-commit hook
# Lightweight: control-plane structure + docs + git diff --check
# No fmt, no clippy, no test — those are global-fortress owned.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

SCRIPT="$REPO_ROOT/scripts/repo-control.ps1"

# Run control-plane check
if [ -f "$SCRIPT" ]; then
    pwsh -NoProfile -File "$SCRIPT" check-control-plane
fi

# Run docs check
if [ -f "$SCRIPT" ]; then
    pwsh -NoProfile -File "$SCRIPT" check-docs
fi

# Git whitespace/blank-at-end check
git diff --check
