#!/usr/bin/env bash
# etwarden repo pre-commit hook
# Thin shim: repo gate logic lives in scripts/repo-control.ps1.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

cd "$REPO_ROOT"

pwsh -NoProfile -File "$REPO_ROOT/scripts/repo-control.ps1" gate:pre-commit
